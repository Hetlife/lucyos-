#!/usr/bin/env python3
from __future__ import annotations
import argparse, json, os, subprocess, sys
from pathlib import Path

ROOT=Path(__file__).resolve().parents[1]
sys.path.insert(0,str(ROOT))
from aion_core import bootstrap, config, db, owner_actions, taskcheck


def settings()->dict:
    path=config.home()/"state"/"HET_TASKS_CONFIG.json"
    try:return json.loads(path.read_text(encoding="utf-8"))
    except (OSError,json.JSONDecodeError):return {}


def send_whatsapp(message:str)->dict:
    cfg=settings(); target=os.environ.get("HET_WHATSAPP_TARGET",cfg.get("whatsapp_target","")).strip()
    binary=os.environ.get("HET_OPENCLAW_BIN",cfg.get("openclaw_bin","/root/.openclaw/bin/openclaw")).strip()
    if not target or not Path(binary).exists(): return {"status":"NOT_CONFIGURED"}
    try:
        p=subprocess.run([binary,"message","send","--channel","whatsapp","--target",target,"--message",message,"--json"],stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True,timeout=30)
    except (OSError,subprocess.TimeoutExpired): return {"status":"FAILED"}
    return {"status":"SENT" if p.returncode==0 else "FAILED"}


def ensure_host()->dict:
    p=subprocess.run([str(ROOT/'scripts'/'taskcheck_host'),'reconcile'],stdout=subprocess.PIPE,text=True,timeout=30,check=True)
    return json.loads(p.stdout)


def create_and_notify(args)->dict:
    out=owner_actions.request(title=args.title,instructions=args.instructions,public_base_url="",expires_hours=args.expires_hours,priority=args.priority,action_type=args.type,evidence_hint=args.evidence_hint)
    host=ensure_host(); base=(host.get("public_url") or "").rstrip("/")
    url=f"{base}/t/{out['access_token']}" if base else ""
    msg=(f"HET TASK\n{args.title}\n\n{args.instructions}\n\nDue: {out['expires_at']}\n"
         + (f"Open: {url}\n" if url else "Open link unavailable; send `het tasks`.\n")
         + f"Task: {out['taskcheck_id']}\n\nWhen done, submit it. LucyOS will update automatically.")
    delivery=send_whatsapp(msg)
    db.log_event("owner_actions","owner_action.notification",out["taskcheck_id"],delivery["status"])
    return {**out,"url":url,"delivery":delivery}


def send_daily()->dict:
    day=owner_actions.util.today(); key=f"het-digest:{day}"
    if db.seen(key,"het_daily_digest"): return {"status":"ALREADY_SENT","day":day}
    msg=owner_actions.daily_digest(); delivery=send_whatsapp(msg)
    if delivery["status"]!="SENT":
        db.connect().execute("DELETE FROM idempotency WHERE key=?",(key,)); db.connect().commit()
    db.log_event("owner_actions","owner_action.daily_digest",day,delivery["status"])
    return {"day":day,"delivery":delivery,"message":msg}


def main():
    p=argparse.ArgumentParser(prog="het_tasks"); sub=p.add_subparsers(dest="cmd",required=True)
    sub.add_parser("digest")
    sub.add_parser("send-daily")
    c=sub.add_parser("create")
    c.add_argument("--title",required=True); c.add_argument("--instructions",required=True)
    c.add_argument("--expires-hours",type=int,default=24); c.add_argument("--priority",type=int,default=2)
    c.add_argument("--type",default="manual"); c.add_argument("--evidence-hint",default="")
    a=p.parse_args(); bootstrap.ensure(); taskcheck.load_builtin_templates()
    if a.cmd=="digest": print(owner_actions.daily_digest()); return 0
    if a.cmd=="send-daily": print(json.dumps(send_daily(),indent=2)); return 0
    print(json.dumps(create_and_notify(a),indent=2)); return 0

if __name__=="__main__": raise SystemExit(main())
