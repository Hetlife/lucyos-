#!/usr/bin/env python3
from __future__ import annotations
import argparse, json, os, re, signal, subprocess, sys, time
from pathlib import Path

ROOT=Path(__file__).resolve().parents[1]
sys.path.insert(0,str(ROOT))
from aion_core import bootstrap, config, taskcheck

RUNTIME=lambda: config.home()/"TASKCHECK"/"runtime"
SERVER_MARKER="bridges/taskcheck_server.py"
TUNNEL_MARKER="cloudflared tunnel"
CLOUDFLARED=Path("/root/lucyos-sandboxes/cloudflared-taskcheck/root/usr/bin/cloudflared")

def _cmdline(pid:int)->str:
    try:return Path(f"/proc/{pid}/cmdline").read_bytes().replace(b"\0",b" ").decode()
    except OSError:return ""

def _discover(marker:str)->int|None:
    for p in Path('/proc').iterdir():
        if p.name.isdigit() and marker in _cmdline(int(p.name)):
            return int(p.name)
    return None

def _stop(pid:int|None,marker:str)->bool:
    if not pid or marker not in _cmdline(pid): return False
    os.kill(pid,signal.SIGTERM)
    return True

def _stop_matching(marker:str)->list[int]:
    stopped=[]
    for p in Path('/proc').iterdir():
        if not p.name.isdigit(): continue
        pid=int(p.name)
        if marker in _cmdline(pid):
            try: os.kill(pid,signal.SIGTERM); stopped.append(pid)
            except ProcessLookupError: pass
    return stopped

def _start_server()->int:
    env=os.environ.copy(); env.setdefault('AION_HOME',str(config.home()))
    log=(RUNTIME()/"server.log").open('ab')
    p=subprocess.Popen([sys.executable,str(ROOT/'bridges/taskcheck_server.py'),'--host','127.0.0.1','--port','8790'],cwd=ROOT,env=env,stdout=log,stderr=log,start_new_session=True)
    return p.pid

def _start_tunnel()->tuple[int,str]:
    if not CLOUDFLARED.is_file(): raise RuntimeError('cloudflared binary unavailable')
    log_path=RUNTIME()/"cloudflared.log"; log=log_path.open('ab')
    p=subprocess.Popen([str(CLOUDFLARED),'tunnel','--no-autoupdate','--url','http://127.0.0.1:8790'],stdout=log,stderr=log,start_new_session=True)
    url=''
    for _ in range(40):
        time.sleep(.25)
        text=log_path.read_text(errors='ignore')[-12000:]
        m=re.findall(r'https://[a-z0-9-]+\.trycloudflare\.com',text)
        if m: url=m[-1]; break
        if p.poll() is not None: break
    if not url: raise RuntimeError('quick tunnel URL not observed')
    (RUNTIME()/"public_url").write_text(url+'\n')
    return p.pid,url

def status()->dict:
    window=taskcheck.active_public_window()
    spid=_discover(SERVER_MARKER); tpid=_discover(TUNNEL_MARKER)
    url=(RUNTIME()/"public_url").read_text().strip() if (RUNTIME()/"public_url").exists() else ''
    return {**window,'server_pid':spid,'tunnel_pid':tpid,'public_url':url,'hosting_required':window['active_count']>0}

def reconcile()->dict:
    RUNTIME().mkdir(parents=True,exist_ok=True,mode=0o700)
    st=status()
    if st['hosting_required']:
        if not st['server_pid']:
            st['server_pid']=_start_server(); time.sleep(.4)
        if not st['tunnel_pid']:
            st['tunnel_pid'],st['public_url']=_start_tunnel()
    else:
        _stop_matching(TUNNEL_MARKER)
        _stop_matching(SERVER_MARKER)
        st['tunnel_pid']=None; st['server_pid']=None; st['public_url']=''
        p=RUNTIME()/"public_url"
        if p.exists(): p.unlink()
    return status()

def main():
    p=argparse.ArgumentParser(prog='taskcheck_host')
    p.add_argument('command',choices=('status','reconcile'))
    a=p.parse_args(); bootstrap.ensure(); taskcheck.load_builtin_templates(); RUNTIME().mkdir(parents=True,exist_ok=True,mode=0o700)
    out=status() if a.command=='status' else reconcile()
    print(json.dumps(out,indent=2))

if __name__=='__main__': main()
