<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.lucyos.aion-interface</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>@REPO@/bridges/http_server.py</string>
		<string>--host</string>
		<string>127.0.0.1</string>
		<string>--port</string>
		<string>8787</string>
	</array>
	<key>WorkingDirectory</key>
	<string>@REPO@</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>AION_HOME</key>
		<string>@AION_HOME@</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>@AION_HOME@/logs/aion-interface.out.log</string>
	<key>StandardErrorPath</key>
	<string>@AION_HOME@/logs/aion-interface.err.log</string>
</dict>
</plist>
