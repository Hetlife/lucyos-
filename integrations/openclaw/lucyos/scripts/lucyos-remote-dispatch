#!/usr/bin/env python3
"""Forced-command SSH dispatcher for the LucyOS OpenClaw bridge.

This is intentionally not a shell. sshd supplies SSH_ORIGINAL_COMMAND; this
program validates it against a small allowlist and invokes AION without shell
expansion. The bridge is read-mostly; architecture checks and work are dry-run.
"""
from __future__ import annotations

import base64
import hashlib
import os
import re
import shlex
import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[4]
AION = os.environ.get("LUCYOS_AION_BIN", str(REPO_ROOT / "aion"))
AION_HOME = os.environ.get("AION_HOME", "/root/openclaw/shared_brain")
MAX_STDIN = 16 * 1024
MAX_OUTPUT = 256 * 1024
TASK_ID = re.compile(r"^(?:TASK-[A-Z0-9]{6,}|S-[0-9]{1,4})$")
ATOM = re.compile(r"^[A-Za-z0-9_.:-]{1,64}$")
MAX_MESSAGE = 512
# Raw-length guard only (the real bound is MAX_MESSAGE): single-quoting expands an
# apostrophe 4x in shell (`'\''`) and 5x with Python's shlex.quote.
MAX_WHATSAPP_COMMAND = 5 * MAX_MESSAGE + 64
KEY_ID = re.compile(r"^[A-Za-z0-9_.:+/=@-]{1,128}$")
MAX_AUTH_INFO = 8 * 1024

SIMPLE = {
    "status": ["status"],
    "health": ["health"],
    "skills": ["skills", "list"],
    "learnrepo-status": ["learnrepo-status"],
    "tasks": ["tasks"],
    "approvals": ["approvals"],
}
def fail(message: str, code: int = 2) -> "NoReturn":
    print(f"bridge refused: {message}", file=sys.stderr)
    raise SystemExit(code)


def parse_original() -> list[str]:
    original = os.environ.get("SSH_ORIGINAL_COMMAND", "").strip()
    if not original:
        fail("missing command")
    if len(original) > MAX_WHATSAPP_COMMAND:
        fail("command too long")
    try:
        parts = shlex.split(original, posix=True)
    except ValueError:
        fail("invalid quoting")
    if not parts:
        fail("missing command")
    # Only `whatsapp` carries free text; every other command keeps the 512 cap.
    if parts[0] != "whatsapp" and len(original) > 512:
        fail("command too long")
    return parts


def fingerprint_from_auth_info(path: str) -> str | None:
    """OpenSSH-style SHA256 fingerprint of the key sshd authenticated.

    sshd (ExposeAuthInfo yes) points SSH_USER_AUTH at a file whose first line is
    'publickey <type> <base64-blob>'. Only sshd sets it; a client cannot.
    """
    try:
        file = Path(path)
        if not file.is_file() or file.stat().st_size > MAX_AUTH_INFO:
            return None
        for line in file.read_text(encoding="utf-8", errors="replace").splitlines():
            fields = line.split()
            if len(fields) >= 3 and fields[0] == "publickey":
                blob = base64.b64decode(fields[2], validate=True)
                digest = base64.b64encode(hashlib.sha256(blob).digest()).decode().rstrip("=")
                return "SHA256:" + digest
    except (OSError, ValueError):
        return None
    return None


def caller_key_id(cli_key_id: str | None) -> str:
    """Identity of the enrolled key. Never client-supplied; fail closed."""
    auth = os.environ.get("SSH_USER_AUTH")
    key_id = (fingerprint_from_auth_info(auth) if auth else None) or cli_key_id
    if not key_id or not KEY_ID.fullmatch(key_id):
        fail("whatsapp needs an enrolled key identity: enable sshd ExposeAuthInfo "
             "or start the forced command with --key-id <label>")
    return key_id


def whatsapp_message(args: list[str]) -> str:
    if len(args) != 1:
        fail("whatsapp takes exactly one quoted message argument")
    text = args[0]
    if not text.strip():
        fail("whatsapp message is empty")
    if not text.isprintable():
        fail("whatsapp message contains a control character or newline")
    try:
        size = len(text.encode("utf-8"))
    except UnicodeEncodeError:
        fail("whatsapp message is not valid UTF-8")
    if size > MAX_MESSAGE:
        fail(f"whatsapp message exceeds {MAX_MESSAGE} bytes")
    return text


def build(parts: list[str], key_id: str | None = None) -> tuple[list[str], bytes | None]:
    command, *args = parts
    if command in SIMPLE:
        if args:
            fail(f"{command} takes no arguments")
        return SIMPLE[command], None

    if command == "context":
        if len(args) != 1 or not TASK_ID.fullmatch(args[0]):
            fail("context requires one valid TASK-ID")
        return ["context", args[0]], None
    if command == "route":
        if not 1 <= len(args) <= 4 or any(not ATOM.fullmatch(a) for a in args):
            fail("route requires 1-4 bounded atom arguments")
        out = ["route", args[0]]
        names = ["--complexity", "--stakes", "--ambiguity"]
        for name, value in zip(names, args[1:]):
            out.extend([name, value])
        return out, None

    if command == "work-dry":
        if len(args) > 1:
            fail("work-dry takes at most one integer")
        maximum = args[0] if args else "1"
        if not maximum.isdigit() or not 1 <= int(maximum) <= 10:
            fail("work-dry max must be 1..10")
        return ["work", "--max", maximum, "--dry-run"], None

    if command == "whatsapp":
        text = whatsapp_message(args)
        identity = caller_key_id(key_id)
        # The principal is derived from the key that authenticated, so the
        # audit trail names the enrolled caller, not a client-asserted string.
        principal = "key:" + re.sub(r"[^A-Za-z0-9]", "", identity)[:24]
        return ["whatsapp", "--channel", "openclaw", "--principal", principal,
                "--key-id", identity, "--", text], None

    if command == "architecture-check":
        if args:
            fail("architecture-check receives JSON on stdin only")
        data = sys.stdin.buffer.read(MAX_STDIN + 1)
        if len(data) > MAX_STDIN:
            fail("architecture proposal too large")
        if not data.strip():
            fail("architecture proposal missing")
        return ["architecture-check", "-"], data

    fail("command is not allowlisted")
def run_aion(argv: list[str], stdin_data: bytes | None) -> int:
    env = {
        "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
        "HOME": "/root",
        "AION_HOME": AION_HOME,
        "LANG": "C.UTF-8",
    }
    temp_path: Path | None = None
    if argv[:2] == ["architecture-check", "-"]:
        import tempfile
        with tempfile.NamedTemporaryFile(prefix="lucyos-arch-", suffix=".json", delete=False) as fh:
            fh.write(stdin_data or b"")
            temp_path = Path(fh.name)
        argv = ["architecture-check", str(temp_path)]
        stdin_data = None
    try:
        result = subprocess.run(
            [AION, *argv], input=stdin_data, stdout=subprocess.PIPE,
            stderr=subprocess.PIPE, env=env, timeout=30, check=False,
        )
    except subprocess.TimeoutExpired:
        fail("LucyOS command timed out", 124)
    finally:
        if temp_path is not None:
            temp_path.unlink(missing_ok=True)

    out = result.stdout[:MAX_OUTPUT]
    err = result.stderr[:MAX_OUTPUT]
    sys.stdout.buffer.write(out)
    sys.stderr.buffer.write(err)
    if len(result.stdout) > MAX_OUTPUT or len(result.stderr) > MAX_OUTPUT:
        print("bridge output truncated", file=sys.stderr)
    return result.returncode


def forced_command_key_id(argv: list[str]) -> str | None:
    """Only `--key-id <label>` is accepted; it is set by the admin in authorized_keys."""
    if not argv:
        return None
    if len(argv) == 2 and argv[0] == "--key-id":
        return argv[1]
    fail("unexpected dispatcher argument")


def main() -> int:
    key_id = forced_command_key_id(sys.argv[1:])
    parts = parse_original()
    argv, stdin_data = build(parts, key_id)
    return run_aion(argv, stdin_data)


if __name__ == "__main__":
    raise SystemExit(main())
