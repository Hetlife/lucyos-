{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lucyos.local/schemas/skill-manifest-v1.json",
  "title": "LucyOS Skill Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill_id",
    "name",
    "version",
    "capabilities",
    "executor_classes",
    "platforms",
    "requirements",
    "cost_class"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "skill_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{2,79}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "executor_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "DET",
          "A",
          "B",
          "C",
          "D"
        ]
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network",
        "ai",
        "offline_supported"
      ],
      "properties": {
        "network": {
          "type": "boolean"
        },
        "ai": {
          "type": "boolean"
        },
        "offline_supported": {
          "type": "boolean"
        }
      }
    },
    "cost_class": {
      "type": "string",
      "minLength": 1
    },
    "enabled": {
      "type": "boolean"
    },
    "health_command": {
      "type": "string"
    },
    "test_command": {
      "type": "string"
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "input_schema": {
      "type": [
        "object",
        "string"
      ]
    },
    "output_schema": {
      "type": [
        "object",
        "string"
      ]
    },
    "risk_class": {
      "type": "string"
    },
    "data_class": {
      "type": "string"
    },
    "fallback": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": [
        "object",
        "string"
      ]
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "retry": {
      "type": [
        "object",
        "string"
      ]
    },
    "idempotency": {
      "type": [
        "object",
        "string"
      ]
    },
    "approval_rule": {
      "type": [
        "object",
        "string"
      ]
    },
    "rollback": {
      "type": [
        "object",
        "string"
      ]
    },
    "feature_flag": {
      "type": "string"
    },
    "lifecycle_state": {
      "enum": [
        "DISCOVERED",
        "RESEARCHED",
        "LICENSE_OK",
        "SECURITY_REVIEWED",
        "SANDBOXED",
        "BENCHMARKED",
        "ARCHITECTURE_APPROVED",
        "OWNER_APPROVED",
        "INSTALLED_DISABLED",
        "TESTED",
        "ACTIVE",
        "DEGRADED",
        "QUARANTINED",
        "DEPRECATED",
        "REJECTED",
        "ROLLED_BACK"
      ]
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "implementation_notes": {
      "type": "string"
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2"
      ]
    },
    "cost_notes": {
      "type": "string"
    }
  }
}
