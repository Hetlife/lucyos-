{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AION work order view v1 (not new task state)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "canonical_task_id",
    "revision",
    "source_sha",
    "objective",
    "project_id",
    "dependencies",
    "executor_class",
    "allowed_paths",
    "do_not_touch",
    "risk",
    "max_tokens",
    "steps",
    "acceptance_tests",
    "rollback",
    "evidence_required",
    "owner_gate"
  ],
  "properties": {
    "schema": {
      "const": "lucy-work-order/1"
    },
    "canonical_task_id": {
      "type": "string",
      "pattern": "^TASK-[A-Za-z0-9-]{4,76}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "objective": {
      "type": "string",
      "minLength": 8,
      "maxLength": 500
    },
    "why": {
      "type": "string",
      "maxLength": 500
    },
    "company_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "dependencies": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 80
      }
    },
    "executor_class": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4",
        "R5"
      ]
    },
    "allowed_paths": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 180
      }
    },
    "do_not_touch": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 180
      }
    },
    "risk": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ]
    },
    "max_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "max_cost_inr": {
      "type": "number",
      "minimum": 0
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "maxLength": 300
      }
    },
    "acceptance_tests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "maxLength": 300
      }
    },
    "rollback": {
      "type": "string",
      "minLength": 3,
      "maxLength": 500
    },
    "evidence_required": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "maxLength": 160
      }
    },
    "owner_gate": {
      "type": "boolean"
    }
  }
}
