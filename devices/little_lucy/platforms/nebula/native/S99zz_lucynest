#!/bin/sh
# Lucy-Nest native display default.
#
# Runs after the stock S99start_app script. It stops only the stock display
# daemons, starts the repo-owned native client on the Home eye animation, and
# falls back to the stock display stack if the native client cannot start.
# It never touches firmware, kernel modules, calibration, or network config.

export TSLIB_CONFFILE=/etc/ts.conf
export TSLIB_TSDEVICE=/dev/input/event0
export TSLIB_FBDEVICE=/dev/fb0
export TSLIB_PLUGINDIR=/usr/lib/ts

NATIVE_DIR=/root/lucy-nest/native
CLIENT="$NATIVE_DIR/client.py"
CONTROL="$NATIVE_DIR/lucynest_ctl.py"
PIDFILE="$NATIVE_DIR/client.pid"
LOGFILE="$NATIVE_DIR/client.log"
BACKUP_DIR=/root/lucy-nest/backups

# The layer mixer stacks fb1, fb2 and fb3 over the framebuffer Lucy-Nest draws
# on (fb0). The Creality logo lives on the overlay layers, so every one of them
# must be cleared, not just fb1.
OVERLAY_FBS="/dev/fb1 /dev/fb2 /dev/fb3"

backup_copy() {
    src=$1
    [ -f "$src" ] || return 0
    mkdir -p "$BACKUP_DIR" || return 1
    base=$(basename "$src")
    stamp=$(date +%Y%m%d%H%M%S)
    cp -p "$src" "$BACKUP_DIR/$base.$stamp" || return 1
    return 0
}

start_stock_display() {
    [ -x /usr/bin/boot_display ] && \
        setsid /usr/bin/boot_display display >/dev/null 2>&1 </dev/null &
    pidof display-server >/dev/null 2>&1 || \
        setsid /usr/bin/display-server >/dev/null 2>&1 </dev/null &
    pidof Monitor >/dev/null 2>&1 || \
        setsid /usr/bin/Monitor >/dev/null 2>&1 </dev/null &
}

# boot_display draws the Creality logo onto the overlay layers the layer mixer
# stacks ON TOP of the framebuffer Lucy-Nest draws on. The stock S99start_app
# has a stop_boot_display() helper but ships it commented out, so the logo stays
# visible over the native UI after boot. Kill it, then clear every overlay
# buffer to fully transparent (0,0,0,0) so nothing can cover /dev/fb0.
stop_boot_display() {
    pids=$(ps | grep '[b]oot_display' | awk '{print $1}')
    [ -n "$pids" ] && kill -9 $pids 2>/dev/null
    return 0
}

clear_overlay() {
    cleared=0
    for fbdev in $OVERLAY_FBS; do
        [ -c "$fbdev" ] || continue
        /usr/bin/python3 -c "
import os
fb = os.open('$fbdev', os.O_RDWR)
os.pwrite(fb, b'\x00' * (480 * 272 * 4), 0)
" 2>/dev/null || return 1
        cleared=$((cleared+1))
    done
    [ "$cleared" -gt 0 ] || return 1
    return 0
}

stop_stock_display() {
    stop_boot_display
    killall Monitor 2>/dev/null
    killall display-server 2>/dev/null
    i=0
    while [ "$i" -lt 12 ]; do
        if ! pidof Monitor >/dev/null 2>&1 && \
           ! pidof display-server >/dev/null 2>&1; then
            clear_overlay || return 1
            return 0
        fi
        sleep 0.5
        i=$((i+1))
    done
    return 1
}

force_home() {
    # Never override the one-time calibration screen. With no calibration the
    # client starts on 'calibrate' and must stay there until the owner has
    # touched all three crosses; forcing 'home' leaves touch unusable.
    [ -f "$NATIVE_DIR/calibration.json" ] || return 0
    j=0
    while [ "$j" -lt 10 ]; do
        if /usr/bin/python3 "$CONTROL" home >/dev/null 2>&1; then
            return 0
        fi
        sleep 0.5
        j=$((j+1))
    done
    return 1
}

start_native() {
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        force_home || true
        return 0
    fi
    [ -f "$CLIENT" ] || return 1
    cd "$NATIVE_DIR" || return 1
    LUCY_NEST_RUNTIME=nebula LUCY_NEST_DISPLAY_OWNER=confirmed \
        setsid /usr/bin/python3 "$CLIENT" >>"$LOGFILE" 2>&1 </dev/null &
    backup_copy "$PIDFILE"
    echo $! >"$PIDFILE"
    sleep 3
    kill -0 "$(cat "$PIDFILE")" 2>/dev/null || return 1
    force_home || true
    return 0
}

case "$1" in
    start)
        # Let S99start_app background the stock display stack first.
        sleep 2
        if ! stop_stock_display; then
            # Stock display did not release the framebuffer; keep it.
            start_stock_display
            exit 0
        fi
        if ! start_native; then
            start_stock_display
        fi
        ;;
    stop)
        if [ -f "$PIDFILE" ]; then
            kill "$(cat "$PIDFILE")" 2>/dev/null
        fi
        ;;
    restart|reload)
        "$0" stop
        "$0" start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit 0
